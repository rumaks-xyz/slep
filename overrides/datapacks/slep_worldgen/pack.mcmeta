{
    "pack": {
        "pack_format": 48,
        "description": "slep worldgen."
    },
    "filter": {
        "block": [
            {
                "namespace": "^atmospheric$",
                "path": "^blueprint/modded_biome_slices/(rainforest|laurel)\\.json$"
            },
            {
                "namespace": "^caverns_and_chasms$",
                "path": "^neoforge/biome_modifier/add_spawn/mime\\.json$"
            },
            {
                "namespace": "^caverns_and_chasms$",
                "path": "^remolders/worldgen/structure_set/mineshafts\\.json$"
            },
            {
                "namespace": "^caverns_and_chasms$",
                "path": "^blueprint/structure_repaletters/bastion_additions\\.json$"
            },
            {
                "namespace": "^upgrade_aquatic$",
                "path": "^neoforge/biome_modifier/add_spawn/nautilus\\.json$"
            },
            {
                "namespace": "^windswept$",
                "path": "^blueprint/structure_repaletters/woodworks_.*\\.json$"
            }
        ]
    }
}
